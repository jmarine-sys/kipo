# Copiar a .env y completar con los datos del proyecto de Supabase.
# El prefijo PUBLIC_ es lo que hace que SvelteKit los exponga al navegador.
# Estas dos son publicas por diseno: la seguridad la da RLS (ADR-007), no el secreto de la clave.
PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx
